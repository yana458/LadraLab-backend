### CLIENT RESERVATIONS
GET http://127.0.0.1:8000/api/reservations
Accept: application/json
#(token de client)
Authorization: Bearer (token de client)

### CLIENT CREATE RESERVATION
POST http://127.0.0.1:8000/api/reservations
Content-Type: application/json
Accept: application/json
#(token de client)
Authorization: Bearer (token de client)

{
  "pet_id": 11,
  "service_id": 1,
  "start_at": "2026-05-10 10:00:00",
  "end_at": "2026-05-10 14:00:00",
  "notes": "Primera estancia"
}

### CLIENT CANCEL RESERVATION
PATCH http://127.0.0.1:8000/api/reservations/1/cancel
Accept: application/json
#(token de client)
Authorization: Bearer (token de client)

### CLIENT -> STAFF RESERVATIONS (debe fallar)
GET http://127.0.0.1:8000/api/staff/reservations
Accept: application/json
#(token de client)
Authorization: Bearer (token de client)

### STAFF RESERVATIONS
GET http://127.0.0.1:8000/api/staff/reservations
Accept: application/json
#(token de staff)
Authorization: Bearer (token de staff)

### STAFF UPDATE RESERVATION
PATCH http://127.0.0.1:8000/api/staff/reservations/1
Content-Type: application/json
Accept: application/json
#(token de staff)
Authorization: Bearer (token de staff)

{
  "status": "confirmed"
}

### STAFF CREATE RESERVATION
POST http://127.0.0.1:8000/api/staff/reservations
Content-Type: application/json
Accept: application/json
#(token de staff)
Authorization: Bearer (token de staff)

{
  "client_user_id": 1,
  "pet_id": 4,
  "service_id": 1,
  "start_at": "2026-05-12 09:00:00",
  "end_at": "2026-05-12 12:00:00",
  "notes": "Reserva creada por recepción"
}

