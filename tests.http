####PARA HACER TODOS ESTOS TESTS SE NECESITA LA EXTENSION REST CLIENT!!!
### LOGIN CLIENT
#(de los logins es que sacamos los tokens para hacer los test)
POST http://127.0.0.1:8000/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "cliente@ladralab.com",
  "password": "password"
}

### LOGIN STAFF
POST http://127.0.0.1:8000/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "staff@ladralab.com",
  "password": "password"
}

### LOGIN ADMIN
POST http://127.0.0.1:8000/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@ladralab.com",
  "password": "password"
}

### UPDATE PROFILE
PATCH http://127.0.0.1:8000/api/auth/profile
Content-Type: application/json
#(token de client)
Authorization: Bearer (token de client)

{
  "name": "Cliente Actualizado",
  "phone": "666999888"
}

### CHANGE PASSWORD
PATCH http://127.0.0.1:8000/api/auth/profile/password
Content-Type: application/json
#(token de client)
Authorization: Bearer (token de client)

{
  "current_password": "password",
  "password": "nuevo123",
  "password_confirmation": "nuevo123"
}

### SERVICE AVAILABILITY
GET http://127.0.0.1:8000/api/services/3/availability?date=2026-05-15
Accept: application/json
#(token de client)
Authorization: Bearer (token de client)

### ADMIN USERS
GET http://127.0.0.1:8000/api/admin/users
#(token de admin)
Authorization: Bearer (token de admin)

### CREATE STAFF
POST http://127.0.0.1:8000/api/admin/users
Content-Type: application/json
#(token de admin)
Authorization: Bearer (token de admin)
{
  "name": "Staff Test",
  "email": "stafftest@ladralab.com",
  "password": "password",
  "phone": "666111222",
  "role": "staff",
  "is_active": true
}

